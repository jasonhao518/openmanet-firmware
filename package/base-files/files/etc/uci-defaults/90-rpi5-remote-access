#!/bin/sh

# Provide working local Wi-Fi and HaLow/B.A.T.M.A.N. defaults for EdgeZ boards.
# On H7608 V1 the local AP is a downstream data network and Ethernet is WAN.

. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name)" in
	"raspberrypi,5-model-b")
		device_mac="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"
		mac_suffix="${device_mac#??????}"
		[ -n "$mac_suffix" ] || mac_suffix='RPI5'
		ap_ssid="EdgeZ-$(printf '%s' "$mac_suffix" | tr '[:lower:]' '[:upper:]')"
		mesh_id='edgez'; mesh_key='edgez123'; gateway_mode=1; upstream_device='eth0'
		;;
	"heltec,ht-hd01-v2")
		ap_ssid='OpenMANET-Heltec'; mesh_id='openmanet'; mesh_key='changeme123'; gateway_mode=0
		;;
	"heltec,ht-h7608-v1"|"morse,ekh03v3")
		device_mac="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"
		mac_suffix="${device_mac#??????}"
		[ -n "$mac_suffix" ] || mac_suffix='H7608'
		ap_ssid="EdgeZ-$(printf '%s' "$mac_suffix" | tr '[:lower:]' '[:upper:]')"
		mesh_id='edgez'
		mesh_key='edgez123'
		gateway_mode=1
		upstream_device=''
		;;
	*) exit 0 ;;
esac

enable_wan_nat() {
	local section="$1"
	local name

	config_get name "$section" name
	[ "$name" = 'wan' ] || return 0
	uci -q set firewall."$section".masq='1'
	uci -q set firewall."$section".mtu_fix='1'
	WAN_ZONE_FOUND=1
}

# Password: openmanet
# Store only the SHA-512 crypt hash in /etc/shadow.
root_password_hash='$6$openmanetrpi5$HpIZfMczlMQwR.9bCFWKm9cNtQNJkz6WUZqdfog/QcyD.tBM5ClLq5R4Zfd2IRGRje/x9Sa7NszFi.6JBpVQn/'
sed -i "s|^root:[^:]*:|root:${root_password_hash}:|" /etc/shadow

# Keep password authentication available through Dropbear SSH.
uci -q set dropbear.@dropbear[0].PasswordAuth='on'
uci -q set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q commit dropbear
/etc/init.d/dropbear enable >/dev/null 2>&1 || true

# Configure the local AP. H7608 V1 uses Heltec's 192.168.100.0/24 downstream
# subnet, avoiding overlap with the common 192.168.12.0/24 Ethernet uplink,
# and shares that uplink rather than creating an OpenMANET management AP.
if [ -n "$ap_ssid" ]; then
	uci -q batch <<-'EOF'
	set network.wifi='interface'
	set network.wifi.proto='static'
	set network.wifi.ipaddr='192.168.12.1'
	set network.wifi.netmask='255.255.255.0'

	set dhcp.wifi='dhcp'
	set dhcp.wifi.interface='wifi'
	set dhcp.wifi.start='100'
	set dhcp.wifi.limit='100'
	set dhcp.wifi.leasetime='12h'
	set dhcp.wifi.ignore='0'
	set dhcp.wifi.dhcpv4='server'
	set dhcp.wifi.dhcpv6='disabled'
	set dhcp.wifi.ra='disabled'

	set firewall.wifi='zone'
	set firewall.wifi.name='wifi'
	add_list firewall.wifi.network='wifi'
	set firewall.wifi.input='ACCEPT'
	set firewall.wifi.output='ACCEPT'
	set firewall.wifi.forward='REJECT'
EOF
	if [ "$gateway_mode" = 1 ]; then
		uci -q set network.wifi.ipaddr='192.168.100.1'
		uci -q set network.wan='interface'
		uci -q set network.wan.proto='dhcp'
		if [ -n "$upstream_device" ]; then
			uci -q set network.wan.device="$upstream_device"
			uci -q delete network.lan
			uci -q delete dhcp.lan
		fi
		uci -q set firewall.wifi.forward='ACCEPT'
		uci -q set firewall.wifi_to_wan='forwarding'
		uci -q set firewall.wifi_to_wan.src='wifi'
		uci -q set firewall.wifi_to_wan.dest='wan'
		uci -q set firewall.ahwlan_to_wan='forwarding'
		uci -q set firewall.ahwlan_to_wan.src='ahwlan'
		uci -q set firewall.ahwlan_to_wan.dest='wan'

		WAN_ZONE_FOUND=0
		config_load firewall
		config_foreach enable_wan_nat zone
		if [ "$WAN_ZONE_FOUND" != 1 ]; then
			uci -q set firewall.wan='zone'
			uci -q set firewall.wan.name='wan'
			uci -q add_list firewall.wan.network='wan'
			uci -q set firewall.wan.input='REJECT'
			uci -q set firewall.wan.output='ACCEPT'
			uci -q set firewall.wan.forward='REJECT'
			uci -q set firewall.wan.masq='1'
			uci -q set firewall.wan.mtu_fix='1'
		fi
	fi
	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
else
	uci -q delete network.wifi
	uci -q delete dhcp.wifi
	uci -q delete firewall.wifi
	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
fi

configure_onboard_iface() {
	local section="$1"
	local wanted_radio="$2"
	local device

	config_get device "$section" device
	[ "$device" = "$wanted_radio" ] || return 0

	uci -q set wireless."$section".mode='ap'
	uci -q set wireless."$section".network='wifi'
	uci -q set wireless."$section".ssid="$ap_ssid"
	uci -q set wireless."$section".encryption='psk2'
	uci -q set wireless."$section".key='openmanet'
	uci -q set wireless."$section".disabled='0'
	ONBOARD_IFACE_CONFIGURED=1
}

configure_onboard_radio() {
	local radio="$1"
	local type section

	config_get type "$radio" type
	[ "$type" = 'mac80211' ] || return 0

	uci -q set wireless."$radio".disabled='0'
	ONBOARD_IFACE_CONFIGURED=0
	config_foreach configure_onboard_iface wifi-iface "$radio"

	if [ "$ONBOARD_IFACE_CONFIGURED" != 1 ]; then
		section="$(uci -q add wireless wifi-iface)"
		[ -n "$section" ] || return 0
		uci -q set wireless."$section".device="$radio"
		uci -q set wireless."$section".mode='ap'
		uci -q set wireless."$section".network='wifi'
		uci -q set wireless."$section".ssid="$ap_ssid"
		uci -q set wireless."$section".encryption='psk2'
		uci -q set wireless."$section".key='openmanet'
	fi
}

configure_morse_iface() {
	local section="$1"
	local wanted_radio="$2"
	local device

	config_get device "$section" device
	[ "$device" = "$wanted_radio" ] || return 0
	[ "$section" = "default_${wanted_radio}" ] || return 0

	uci -q set wireless."$section".mode='mesh'
	uci -q set wireless."$section".network='batmesh0'
	uci -q set wireless."$section".mesh_id="$mesh_id"
	uci -q delete wireless."$section".ssid
	uci -q set wireless."$section".encryption='sae'
	uci -q set wireless."$section".key="$mesh_key"
	uci -q set wireless."$section".beacon_int='1000'
	uci -q set wireless."$section".wds='1'
	uci -q set wireless."$section".disabled='0'
	MORSE_IFACE_CONFIGURED=1
}

configure_morse_radio() {
	local radio="$1"
	local type section

	config_get type "$radio" type
	[ "$type" = 'morse' ] || return 0

	# Match the radio settings applied by the OpenMANET mesh wizard while
	# retaining the hardware path, country and channel detected by Morse.
	uci -q set wireless."$radio".enable_mcast_whitelist='0'
	uci -q set wireless."$radio".enable_mcast_rate_control='1'
	uci -q set wireless."$radio".enable_ps='0'
	uci -q set wireless."$radio".enable_dynamic_ps_offload='0'
	uci -q set wireless."$radio".enable_twt='0'
	uci -q set wireless."$radio".disabled='0'
	if [ "$gateway_mode" = 1 ]; then
		# Match the EdgeZ ESP32 mesh default: US channel 27, 1 MHz, 915.5 MHz.
		uci -q set wireless."$radio".country='US'
		uci -q set wireless."$radio".channel='27'
		uci -q set wireless."$radio".s1g_prim_chwidth='1'
		uci -q set wireless."$radio".s1g_prim_1mhz_chan_index='0'
	fi

	MORSE_IFACE_CONFIGURED=0
	config_foreach configure_morse_iface wifi-iface "$radio"

	if [ "$MORSE_IFACE_CONFIGURED" != 1 ]; then
		section="default_${radio}"
		uci -q set wireless."$section"='wifi-iface'
		uci -q set wireless."$section".device="$radio"
		uci -q set wireless."$section".mode='mesh'
		uci -q set wireless."$section".network='batmesh0'
		uci -q set wireless."$section".mesh_id="$mesh_id"
		uci -q set wireless."$section".encryption='sae'
		uci -q set wireless."$section".key="$mesh_key"
		uci -q set wireless."$section".beacon_int='1000'
		uci -q set wireless."$section".wds='1'
	fi
}

config_load wireless
if [ -n "$ap_ssid" ]; then
	config_foreach configure_onboard_radio wifi-device
fi
config_foreach configure_morse_radio wifi-device
uci -q commit wireless

# Mirror the mesh wizard's B.A.T.M.A.N. topology and tuning. Gateway-capable
# profiles override the client setting after the shared topology is created.
uci -q batch <<-'EOF'
	set network.bat0='interface'
	set network.bat0.proto='batadv'
	set network.bat0.mtu='1400'
	set network.bat0.routing_algo='BATMAN_IV'
	set network.bat0.bridge_loop_avoidance='1'
	set network.bat0.hop_penalty='30'
	set network.bat0.bonding='1'
	set network.bat0.aggregated_ogms='1'
	set network.bat0.ap_isolation='0'
	set network.bat0.fragmentation='1'
	set network.bat0.orig_interval='1000'
	set network.bat0.distributed_arp_table='1'
	set network.bat0.multicast_mode='1'
	set network.bat0.network_coding='1'
	set network.bat0.isolation_mark='0x00000000/0x00000000'
	set network.bat0.gw_mode='client'

	set network.batmesh0='interface'
	set network.batmesh0.proto='batadv_hardif'
	set network.batmesh0.master='bat0'

	set network.br_ahwlan='device'
	set network.br_ahwlan.name='br-ahwlan'
	set network.br_ahwlan.type='bridge'
	set network.br_ahwlan.mtu='1400'
	delete network.br_ahwlan.ports
	add_list network.br_ahwlan.ports='bat0'

	set network.ahwlan='interface'
	set network.ahwlan.device='br-ahwlan'
	set network.ahwlan.proto='static'
	set network.ahwlan.mtu='1400'
	set network.ahwlan.netmask='255.255.0.0'
	set network.ahwlan.ip6assign='64'
	set network.ahwlan.ip6ifaceid='eui64'
	delete network.ahwlan.ip6class
	add_list network.ahwlan.ip6class='local'
	set network.ahwlan.dns='1.1.1.1'

	set firewall.ahwlan='zone'
	set firewall.ahwlan.name='ahwlan'
	add_list firewall.ahwlan.network='ahwlan'
	set firewall.ahwlan.input='ACCEPT'
	set firewall.ahwlan.output='ACCEPT'
	set firewall.ahwlan.forward='ACCEPT'
	set firewall.ahwlan.mtu_fix='1'
EOF

# The wizard chooses 10.41.254.[0-253] for a mesh point. Derive an address in
# the same range from the device Ethernet MAC so it remains stable and normally
# differs between nodes without depending on optional BusyBox applets.
mesh_mac="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"
mesh_mac_tail="${mesh_mac#????????}"
case "$mesh_mac_tail" in
	''|*[!0-9a-fA-F]*) mesh_host_octet=1 ;;
	*) mesh_host_octet=$((0x${mesh_mac_tail} % 254)) ;;
esac
uci -q set network.ahwlan.ipaddr="10.41.254.${mesh_host_octet}"

uci -q set mesh11sd.mesh_params.mesh_fwding='0'
if [ "$gateway_mode" = 1 ]; then
	uci -q set network.bat0.gw_mode='server'
	uci -q set network.bat0.gw_bandwidth='100mbit/100mbit'
	uci -q set mesh11sd.mesh_params.mesh_gate_announcements='1'
else
	uci -q set mesh11sd.mesh_params.mesh_gate_announcements='0'
fi

uci -q commit network
uci -q commit firewall
uci -q commit mesh11sd

# Keep the UI's suggested AP password consistent with the boot default.
uci -q set system.@system[0].default_wifi_key='openmanet'
uci -q commit system

exit 0
