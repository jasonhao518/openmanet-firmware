#!/bin/sh
# Register one netifd protocol interface. Learned routes remain runtime state.
# Fill missing fields on upgrades without replacing administrator overrides.
network_changed=0
firewall_changed=0
alfred_changed=0

ensure_option() {
	local option="$1" value="$2"
	if [ -z "$(uci -q get network.edgez_routes."$option")" ]; then
		uci set network.edgez_routes."$option"="$value"
		network_changed=1
	fi
}

ensure_network_option() {
	local section="$1" option="$2" value="$3"
	if uci -q get network."$section" >/dev/null &&
	   [ -z "$(uci -q get network."$section"."$option")" ]; then
		uci set network."$section"."$option"="$value"
		network_changed=1
	fi
}

ensure_firewall_option() {
	local section="$1" option="$2" value="$3"
	if [ -z "$(uci -q get firewall."$section"."$option")" ]; then
		uci set firewall."$section"."$option"="$value"
		firewall_changed=1
	fi
}

find_firewall_zone() {
	local wanted="$1" section zone_name
	for section in $(uci -q show firewall | sed -n "s/^firewall\.\([^.=]*\)=zone$/\1/p"); do
		zone_name="$(uci -q get firewall."$section".name)"
		[ "$zone_name" = "$wanted" ] && {
			printf '%s\n' "$section"
			return 0
		}
	done
	return 1
}

find_network_device() {
	local wanted="$1" section device_name
	for section in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
		device_name="$(uci -q get network."$section".name)"
		[ "$device_name" = "$wanted" ] && {
			printf '%s\n' "$section"
			return 0
		}
	done
	return 1
}

ensure_forwarding() {
	local section="$1" src="$2" dest="$3"
	if ! uci -q get firewall."$section" >/dev/null; then
		uci set firewall."$section"=forwarding
		firewall_changed=1
	fi
	if [ "$(uci -q get firewall."$section".src)" != "$src" ]; then
		uci set firewall."$section".src="$src"
		firewall_changed=1
	fi
	if [ "$(uci -q get firewall."$section".dest)" != "$dest" ]; then
		uci set firewall."$section".dest="$dest"
		firewall_changed=1
	fi
	if [ "$(uci -q get firewall."$section".enabled)" != 1 ]; then
		uci set firewall."$section".enabled=1
		firewall_changed=1
	fi
}

if ! uci -q get network.edgez_routes >/dev/null; then
	uci set network.edgez_routes=interface
	network_changed=1
fi
ensure_option proto edgez_routes
ensure_option device br-ahwlan
ensure_option mesh_device br-ahwlan
ensure_option leasefile /tmp/dhcp.leases
ensure_option socket /var/run/alfred.sock
ensure_option local_network wifi
ensure_option wan_network wan
ensure_option gateway_down_kbps 100000
ensure_option gateway_up_kbps 100000
ensure_option status_file /tmp/edgez-routes-status.json

batman_gateway_mode="$(uci -q get network.bat0.gw_mode)"
if [ "$batman_gateway_mode" = server ]; then
	uci set network.edgez_routes.gateway_mode=1
	uci set network.edgez_routes.manage_default=0
else
	uci set network.edgez_routes.gateway_mode=0
	uci set network.edgez_routes.manage_default=1
fi
uci set network.edgez_routes.require_lease=0
network_changed=1

# The upstream Alfred package is deliberately disabled and listens on br-lan
# by default. This mesh has no shared br-lan: all route advertisements travel
# over br-ahwlan. Run every node as a master so the directory remains usable
# when any one gateway disappears.
uci -q set alfred.alfred='alfred'
uci -q delete alfred.alfred.interface
uci -q add_list alfred.alfred.interface='br-ahwlan'
uci -q set alfred.alfred.mode='master'
uci -q set alfred.alfred.batmanif='bat0'
uci -q set alfred.alfred.disabled='0'
alfred_changed=1

if uci -q get network.wifi >/dev/null; then
	ensure_forwarding wifi_to_ahwlan wifi ahwlan
	ensure_forwarding ahwlan_to_wifi ahwlan wifi
	[ "$batman_gateway_mode" != server ] || ensure_forwarding wifi_to_wan wifi wan
fi
ensure_network_option bat0 mtu 1400
ensure_network_option ahwlan mtu 1400
bridge_section="$(find_network_device br-ahwlan)"
if [ -n "$bridge_section" ]; then
	ensure_network_option "$bridge_section" mtu 1400
	ensure_network_option "$bridge_section" bridge_empty 1
fi

# Preserve source addresses for the private routed mesh, but masquerade public
# Internet destinations at a mesh point.  This lets a new routed /27 use a
# legacy gateway which has not learned that /27 yet, without hiding addresses
# from upgraded peers inside 10.0.0.0/8.
ahwlan_zone="$(find_firewall_zone ahwlan)"
if [ -n "$ahwlan_zone" ]; then
	if [ "$batman_gateway_mode" = server ]; then
		uci set firewall."$ahwlan_zone".masq=0
		uci set firewall."$ahwlan_zone".mtu_fix=0
		uci -q delete firewall."$ahwlan_zone".masq_dest
	else
		uci set firewall."$ahwlan_zone".masq=1
		uci set firewall."$ahwlan_zone".mtu_fix=1
		uci -q delete firewall."$ahwlan_zone".masq_dest
		uci -q add_list firewall."$ahwlan_zone".masq_dest='!10.0.0.0/8'
	fi
	firewall_changed=1
fi
[ "$network_changed" = 0 ] || uci commit network
[ "$alfred_changed" = 0 ] || uci commit alfred
/etc/init.d/alfred enable >/dev/null 2>&1 || true

# Only gateways forward mesh traffic to WAN and configure WAN masquerading.
if [ "$batman_gateway_mode" = server ]; then
	ensure_forwarding edgez_to_wan ahwlan wan
	wan_zone="$(find_firewall_zone wan)"
	if [ -n "$wan_zone" ]; then
		ensure_firewall_option "$wan_zone" masq 1
		ensure_firewall_option "$wan_zone" mtu_fix 1
	else
		logger -t edgez-routes "WAN firewall zone not found; skipping masquerade setup"
	fi
fi

if [ "$firewall_changed" != 0 ]; then
	uci commit firewall
	# Apply the policy immediately for live package upgrades. During image boot
	# the service may not be running yet; the normal firewall startup will read
	# the committed configuration, so a failed reload is harmless.
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
fi

exit 0
