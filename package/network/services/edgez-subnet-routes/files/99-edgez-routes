#!/bin/sh
# Register one netifd protocol interface. Learned routes remain runtime state.
uci -q get network.edgez_routes >/dev/null && exit 0
uci batch <<'EOF'
set network.edgez_routes=interface
set network.edgez_routes.proto='edgez_routes'
set network.edgez_routes.device='br-ahwlan'
set network.edgez_routes.require_lease='1'
set network.edgez_routes.leasefile='/tmp/dhcp.leases'
set network.edgez_routes.socket='/var/run/alfred.sock'
commit network
EOF
