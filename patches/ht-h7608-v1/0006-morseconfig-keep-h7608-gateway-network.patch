From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenMANET Firmware <noreply@openmanet.local>
Date: Tue, 15 Sep 2026 01:30:00 +0200
Subject: [PATCH] morseconfig: keep H7608 routed mesh topology

Keep every local Wi-Fi AP on its routed /27, let edgez_routes select the
default gateway, and prevent mesh forwarding from enabling NAT on ahwlan.
Also hide a raw Ethernet parent when its VLAN child is the usable switch port.
---
--- a/feeds/openmanet/luci/luci-app-ekhwizards/htdocs/luci-static/resources/view/morse/meshwizard.js
+++ b/feeds/openmanet/luci/luci-app-ekhwizards/htdocs/luci-static/resources/view/morse/meshwizard.js
@@ -212 +212,4 @@ return wizard.AbstractWizardView.extend({
-				const upstreamNetwork = device_mode_meshgate === 'router_firewall' ? 'wan' : 'lan';
+				const upstreamNetwork = 'wan';
+				const wifiIface = 'wifi';
+				const wifiIp = uci.get('network', wifiIface, 'ipaddr') ?? '10.80.0.1';
+				wizard.setupNetworkIface(wifiIface, { local: true });
@@ -227 +230 @@ return wizard.AbstractWizardView.extend({
-						uci.set('wireless', wifiDevice.apInterfaceName, 'network', 'ahwlan');
+						uci.set('wireless', wifiDevice.apInterfaceName, 'network', wifiIface);
@@ -240,0 +244 @@ return wizard.AbstractWizardView.extend({
+				morseuci.createOrRemoveBridgeAsNeeded(wifiIface);
@@ -243,0 +248,14 @@ return wizard.AbstractWizardView.extend({
+				uci.set('network', wifiIface, 'proto', 'static');
+				uci.set('network', wifiIface, 'ipaddr', wifiIp);
+				uci.set('network', wifiIface, 'netmask', '255.255.255.224');
+				morseuci.setupNetworkWithDnsmasq(wifiIface, wifiIp, true, false);
+				for (const [name, src, dest] of [
+					['wifi_to_ahwlan', wifiIface, 'ahwlan'],
+					['ahwlan_to_wifi', 'ahwlan', wifiIface],
+					['wifi_to_wan', wifiIface, upstreamNetwork],
+				]) {
+					uci.set('firewall', name, 'forwarding');
+					uci.set('firewall', name, 'src', src);
+					uci.set('firewall', name, 'dest', dest);
+					uci.set('firewall', name, 'enabled', '1');
+				}
@@ -266,0 +284,14 @@ return wizard.AbstractWizardView.extend({
+				const wifiIface = 'wifi';
+				const wifiIp = uci.get('network', wifiIface, 'ipaddr') ?? '10.80.0.1';
+
+				wizard.setupNetworkIface(wifiIface, { local: true });
+				for (const wifiDevice of wifiDevices) {
+					if (wifiApsEnabled[wifiDevice.name]) {
+						uci.set('wireless', wifiDevice.apInterfaceName, 'network', wifiIface);
+					}
+				}
+				morseuci.createOrRemoveBridgeAsNeeded(ethIface);
+				morseuci.createOrRemoveBridgeAsNeeded(wifiIface);
+				uci.set('network', wifiIface, 'proto', 'static');
+				uci.set('network', wifiIface, 'ipaddr', wifiIp);
+				uci.set('network', wifiIface, 'netmask', '255.255.255.224');
@@ -269,0 +301 @@ return wizard.AbstractWizardView.extend({
+				morseuci.setupNetworkWithDnsmasq(wifiIface, wifiIp, true, false);
@@ -270,0 +303,5 @@ return wizard.AbstractWizardView.extend({
+				morseuci.getOrCreateForwarding(wifiIface, halowIface, 'wifi_to_ahwlan', false);
+				uci.set('firewall', 'ahwlan_to_wifi', 'forwarding');
+				uci.set('firewall', 'ahwlan_to_wifi', 'src', halowIface);
+				uci.set('firewall', 'ahwlan_to_wifi', 'dest', wifiIface);
+				uci.set('firewall', 'ahwlan_to_wifi', 'enabled', '1');
@@ -282,0 +319,73 @@ return wizard.AbstractWizardView.extend({
+
+		// resetUci() may restore an old bridged layout and disabled forwarding
+		// sections.  Normalize the routed H7608 topology after every wizard mode.
+		const wifiIface = 'wifi';
+		const wifiIp = uci.get('network', wifiIface, 'ipaddr') ?? '10.80.0.1';
+		wizard.setupNetworkIface(wifiIface, { local: true });
+		uci.set('network', wifiIface, 'proto', 'static');
+		uci.set('network', wifiIface, 'ipaddr', wifiIp);
+		uci.set('network', wifiIface, 'netmask', '255.255.255.224');
+		morseuci.setupNetworkWithDnsmasq(wifiIface, wifiIp, true, false);
+		const wifiDhcp = morseuci.getOrCreateDhcp(
+			morseuci.getOrCreateDnsmasq(wifiIface), wifiIface);
+		uci.set('dhcp', wifiDhcp, 'ignore', '0');
+		uci.set('dhcp', wifiDhcp, 'dhcpv4', 'server');
+		uci.set('dhcp', wifiDhcp, 'dhcpv6', 'disabled');
+		uci.set('dhcp', wifiDhcp, 'ra', 'disabled');
+		for (const wifiDevice of wifiDevices) {
+			if (wifiApsEnabled[wifiDevice.name]) {
+				uci.set('wireless', wifiDevice.apInterfaceName, 'network', wifiIface);
+			}
+		}
+		for (const [name, src, dest, enabled] of [
+			['wifi_to_ahwlan', wifiIface, 'ahwlan', '1'],
+			['ahwlan_to_wifi', 'ahwlan', wifiIface, '1'],
+			['wifi_to_wan', wifiIface, 'wan', isMeshGate ? '1' : '0'],
+			['ahwlan_to_wan', 'ahwlan', 'wan', isMeshGate ? '1' : '0'],
+			['edgez_to_wan', 'ahwlan', 'wan', isMeshGate ? '1' : '0'],
+		]) {
+			uci.set('firewall', name, 'forwarding');
+			uci.set('firewall', name, 'src', src);
+			uci.set('firewall', name, 'dest', dest);
+			uci.set('firewall', name, 'enabled', enabled);
+		}
+		uci.set('network', 'bat0', 'mtu', '1400');
+		uci.set('network', 'ahwlan', 'mtu', '1400');
+		let ahwlanBridge = uci.sections('network', 'device')
+			.find(device => device.type === 'bridge' && device.name === 'br-ahwlan');
+		if (!ahwlanBridge) {
+			const bridgeSection = uci.add('network', 'device');
+			uci.set('network', bridgeSection, 'name', 'br-ahwlan');
+			uci.set('network', bridgeSection, 'type', 'bridge');
+			ahwlanBridge = uci.get('network', bridgeSection);
+		}
+		uci.set('network', ahwlanBridge['.name'], 'ports', ['bat0']);
+		uci.set('network', ahwlanBridge['.name'], 'mtu', '1400');
+		uci.set('network', ahwlanBridge['.name'], 'bridge_empty', '1');
+		uci.set('network', 'ahwlan', 'device', 'br-ahwlan');
+		uci.set('network', 'edgez_routes', 'device', 'br-ahwlan');
+		if (isMeshGate) {
+			uci.remove('network', 'legacy_mesh_gateway');
+		} else {
+			uci.set('network', 'legacy_mesh_gateway', 'route');
+			uci.set('network', 'legacy_mesh_gateway', 'interface', 'ahwlan');
+			uci.set('network', 'legacy_mesh_gateway', 'target', '0.0.0.0/0');
+			uci.set('network', 'legacy_mesh_gateway', 'gateway', '10.41.0.1');
+			uci.set('network', 'legacy_mesh_gateway', 'metric', '2048');
+		}
+		const ahwlanZone = uci.sections('firewall', 'zone')
+			.find(zone => zone.name === 'ahwlan');
+		if (ahwlanZone) {
+			const section = ahwlanZone['.name'];
+			uci.set('firewall', section, 'masq', isMeshGate ? '0' : '1');
+			uci.set('firewall', section, 'mtu_fix', isMeshGate ? '0' : '1');
+			if (isMeshGate) {
+				uci.unset('firewall', section, 'masq_dest');
+			} else {
+				uci.set('firewall', section, 'masq_dest', ['!10.0.0.0/8']);
+			}
+		}
+		uci.set('network', 'edgez_routes', 'gateway_mode', isMeshGate ? '1' : '0');
+		uci.set('network', 'edgez_routes', 'manage_default', isMeshGate ? '0' : '1');
+		uci.set('network', 'edgez_routes', 'local_network', 'wifi');
+		uci.set('network', 'edgez_routes', 'require_lease', '0');
--- a/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js
+++ b/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js
@@ -58 +58 @@ function getDefaultWifiKey() {
-function getOrCreateForwarding(srcZone, destZone, name = undefined) {
+function getOrCreateForwarding(srcZone, destZone, name = undefined, masquerade = true) {
@@ -72,3 +72,5 @@ function getOrCreateForwarding(srcZone, destZone, name = undefined) {
-	const zoneSection = uci.sections('firewall', 'zone').find(z => z['name'] === destZone);
-	uci.set('firewall', zoneSection['.name'], 'mtu_fix', '1');
-	uci.set('firewall', zoneSection['.name'], 'masq', '1');
+	if (masquerade) {
+		const zoneSection = uci.sections('firewall', 'zone').find(z => z['name'] === destZone);
+		uci.set('firewall', zoneSection['.name'], 'mtu_fix', '1');
+		uci.set('firewall', zoneSection['.name'], 'masq', '1');
+	}
@@ -582,2 +584,2 @@ function setupNetworkWithDnsmasq(sectionId, ip, uplink = true, isMeshPoint = tru
-			// Disable setting gateway, openmanetd handles this now via ip route
-			// uci.set('network', sectionId, 'gateway', '10.41.1.1');
+			// edgez_routes selects a live gateway from the distributed directory.
+			uci.unset('network', sectionId, 'gateway');
@@ -584,0 +587,2 @@ function setupNetworkWithDnsmasq(sectionId, ip, uplink = true, isMeshPoint = tru
+			uci.set('network', sectionId, 'force_link', '1');
+			uci.set('dhcp', dhcp, 'ignore', '1');
@@ -586,2 +590,3 @@ function setupNetworkWithDnsmasq(sectionId, ip, uplink = true, isMeshPoint = tru
-			// Disable setting gateway ip address, openmanetd handles this now
-			// uci.set('network', sectionId, 'ipaddr', '10.41.1.1');
+			// Preserve the stable per-device gateway address allocated at first boot.
+			uci.set('network', sectionId, 'ipaddr',
+				uci.get('network', sectionId, 'ipaddr') ?? getRandomIpaddr(ip));
@@ -642,0 +648,3 @@ function getFirstNetmask(iface) {
+	const vlanParents = new Set(networkDevices
+		.filter(device => device.getType() === 'vlan')
+		.map(device => device.getName().replace(/\.[^.]+$/, '')));
@@ -649 +657,3 @@ function getFirstNetmask(iface) {
-		if (!['ethernet', 'vlan'].includes(device.getType()) || device.dev.type === 803) {
+		const deviceType = device.getType();
+		const deviceName = device.getName();
+		if (!['ethernet', 'vlan'].includes(deviceType) || device.dev.type === 803) {
@@ -654,0 +665,3 @@ function getFirstNetmask(iface) {
+		if (deviceType === 'ethernet' && vlanParents.has(deviceName)) {
+			continue;
+		}
-- 
2.50.1
