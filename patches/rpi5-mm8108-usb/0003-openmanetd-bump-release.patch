From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenMANET Firmware <noreply@openmanet.local>
Date: Sat, 15 Aug 2026 17:30:00 +0200
Subject: [PATCH] openmanetd: rebuild package with Raspberry Pi 5 Comms fix

Bump the package release for the Raspberry Pi 5 build so incremental OpenWrt
builds cannot reuse an openmanetd package prepared before the board-support
patch was added.
---
 feeds/openmanet/openmanetd/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/feeds/openmanet/openmanetd/Makefile b/feeds/openmanet/openmanetd/Makefile
index 3d1bbc1..530b8d1 100644
--- a/feeds/openmanet/openmanetd/Makefile
+++ b/feeds/openmanet/openmanetd/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=openmanetd
 PKG_VERSION:=1.3.2-camera-sensor-cot
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/OpenMANET/openmanetd
-- 
2.50.1
