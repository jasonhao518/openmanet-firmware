From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenMANET Firmware <noreply@openmanet.local>
Date: Sat, 15 Aug 2026 17:20:00 +0200
Subject: [PATCH] morseconfig: configure BATMAN_IV on Heltec

The ESP32 mesh nodes implement BATMAN_IV. Ensure a Heltec mesh configured by
the Morse wizard selects the same routing algorithm instead of BATMAN_V.
---
 .../htdocs/luci-static/resources/tools/morse/uci.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js b/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js
index 4f14c5a..25c41ab 100644
--- a/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js
+++ b/feeds/openmanet/luci/luci-app-morseconfig/htdocs/luci-static/resources/tools/morse/uci.js
@@ -448,7 +448,7 @@ function setupBatmanDeviceOnNetwork(gwMode = 'client', deviceName = 'bat0') {
 	}
 
 	uci.set('network', deviceName, 'proto', 'batadv');
-	uci.set('network', deviceName, 'routing_algo', 'BATMAN_V');
+	uci.set('network', deviceName, 'routing_algo', 'BATMAN_IV');
 	uci.set('network', deviceName, 'bridge_loop_avoidance', '1');
 	uci.set('network', deviceName, 'hop_penalty', '30');
 	uci.set('network', deviceName, 'bonding', '1');
-- 
2.50.1
