CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_heltec_ht-h7608-v1=y

CONFIG_VERSION_MANUFACTURER="Heltec"
CONFIG_VERSION_PRODUCT="HT-H7608-V1"

# HT-H7608 V1 uses an MT7628 host and an MM6108 connected over SDIO.
CONFIG_PACKAGE_morse-fw-6108=y
CONFIG_PACKAGE_morse-fw-6108-tlm=n
CONFIG_PACKAGE_morse-fw-8108=n
CONFIG_PACKAGE_morse-fw-8108-tlm=n
CONFIG_PACKAGE_morse-fw-8108-flm=n
CONFIG_PACKAGE_kmod-morse=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci-mt7620=y
CONFIG_PACKAGE_netifd-morse=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_morse-board-config=y
CONFIG_PACKAGE_morse-board-config-hotplug-model=y
CONFIG_PACKAGE_gpiod-tools=y

# MT7628's integrated 2.4 GHz radio provides the downstream client AP.
CONFIG_PACKAGE_kmod-mt7603=y

# The HD01-specific service and transparent-wire defaults do not describe the
# H7608 V1 deployment. EdgeZ configures its HaLow interface as a mesh point.
CONFIG_PACKAGE_bsp-ht-hd01-v2=n
CONFIG_PACKAGE_ht-service=n
CONFIG_PACKAGE_virtual-wire=n
CONFIG_PACKAGE_kmod-trelay=n
CONFIG_PACKAGE_morse-mode=n
CONFIG_PACKAGE_morse-boot-prints=n

# EdgeZ/B.A.T.M.A.N. mesh interoperability and diagnostics.
CONFIG_PACKAGE_alfred=y
CONFIG_PACKAGE_edgez-subnet-routes=y
CONFIG_PACKAGE_batctl-full=y
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=n
CONFIG_PACKAGE_iperf=y

# Not used by this board.
CONFIG_PACKAGE_ftdi-usb-spi=n
CONFIG_PACKAGE_kmod-ftdi-usb-spi=n
CONFIG_PACKAGE_bsp-halowlink2=n
# openmanetd currently builds its malgo audio backend with the x86-only -msse2
# flag. Neither this service nor its audio stack is used by the EdgeZ gateway.
CONFIG_PACKAGE_openmanetd=n
CONFIG_PACKAGE_alsa-ucm-conf=n
CONFIG_PACKAGE_alsa-utils=n
CONFIG_PACKAGE_alsa-lib=n
CONFIG_PACKAGE_libopus=n
CONFIG_PACKAGE_portaudio=n
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_kmod-usb-audio=n
CONFIG_PACKAGE_kmod-input-gpio-encoder=n
CONFIG_PACKAGE_gpsd=n
CONFIG_PACKAGE_gpsd-clients=n
CONFIG_PACKAGE_ALFRED_GPSD=n
CONFIG_PACKAGE_tailscale=n
CONFIG_PACKAGE_relayd=n
CONFIG_PACKAGE_luci-proto-relay=n
CONFIG_PACKAGE_dpp-handler=n
CONFIG_PACKAGE_vxlan=n
CONFIG_PACKAGE_luci-proto-vxlan=n

# Exclude unrelated Wi-Fi and USB firmware from the constrained image.
CONFIG_PACKAGE_ath10k-firmware-qca6174=n
CONFIG_PACKAGE_ath11k-firmware-wcn6855=n
CONFIG_PACKAGE_ath9k-htc-firmware=n
CONFIG_PACKAGE_iwlwifi-firmware-ax200=n
CONFIG_PACKAGE_iwlwifi-firmware-ax210=n
CONFIG_PACKAGE_kmod-ath10k=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-ath9k=n
CONFIG_PACKAGE_kmod-ath9k-common=n
CONFIG_PACKAGE_kmod-ath9k-htc=n
CONFIG_PACKAGE_kmod-iwlwifi=n
CONFIG_PACKAGE_kmod-rt2800-lib=n
CONFIG_PACKAGE_kmod-rt2800-usb=n
CONFIG_PACKAGE_kmod-rt2x00-lib=n
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_kmod-mt7915-firmware=n
CONFIG_PACKAGE_kmod-mt7916-firmware=n
CONFIG_PACKAGE_edgeport-firmware=n
CONFIG_PACKAGE_r8152-firmware=n
CONFIG_PACKAGE_kmod-usb-serial-edgeport=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-owl-loader=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
