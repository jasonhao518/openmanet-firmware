CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_openmanet_mt76x8-mm8108-usb=y

CONFIG_VERSION_MANUFACTURER="OpenMANET"
CONFIG_VERSION_PRODUCT="MT76x8 MM8108 USB"

# MM8108 USB-only target. The split MM8108 driver provides kmod-morse;
# keep both MM6108 drivers/firmware and the legacy unified driver out.
CONFIG_PACKAGE_kmod-mm8108=y
CONFIG_PACKAGE_mm8108-firmware=y
CONFIG_PACKAGE_kmod-mm6108=n
CONFIG_PACKAGE_mm6108-firmware=n
CONFIG_PACKAGE_morse-fw-6108=n
CONFIG_PACKAGE_morse-fw-6108-tlm=n
CONFIG_PACKAGE_kmod-morse=n
CONFIG_PACKAGE_morse-board-config=n

CONFIG_MORSE_USB=y
CONFIG_MORSE_SDIO=n
CONFIG_MORSE_USER_ACCESS=y
CONFIG_MORSE_VENDOR_COMMAND=y
CONFIG_MORSE_POWERSAVE_MODE=0
CONFIG_MORSE_RC=y
CONFIG_MORSE_MONITOR=y
CONFIG_WLAN_VENDOR_MORSE=m

# MT76x8 USB 2.0 host support for the MM8108 dongle.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-mmc=n
CONFIG_PACKAGE_kmod-sdhci=n

# Ethernet-to-HaLow transparent bridge.
CONFIG_PACKAGE_virtual-wire=y
CONFIG_PACKAGE_kmod-trelay=y

# No audio or OpenVLM hardware on this router profile.
CONFIG_PACKAGE_alsa-ucm-conf=n
CONFIG_PACKAGE_alsa-utils=n
CONFIG_PACKAGE_openvlm=n

# Exclude GPS packages.
CONFIG_PACKAGE_gpsd=n
CONFIG_PACKAGE_gpsd-clients=n

# Exclude unrelated Wi-Fi firmware and drivers.
CONFIG_PACKAGE_ath10k-firmware-qca6174=n
CONFIG_PACKAGE_ath11k-firmware-wcn6855=n
CONFIG_PACKAGE_ath9k-htc-firmware=n
CONFIG_PACKAGE_iwlwifi-firmware-ax200=n
CONFIG_PACKAGE_iwlwifi-firmware-ax210=n
CONFIG_PACKAGE_kmod-ath10k=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-ath9k=n
CONFIG_PACKAGE_kmod-ath9k-common=n
CONFIG_PACKAGE_kmod-ath9k-htc=n
CONFIG_PACKAGE_kmod-iwlwifi=n
CONFIG_PACKAGE_kmod-mt7603=n
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_kmod-mt7915-firmware=n
CONFIG_PACKAGE_kmod-mt7916-firmware=n

# Exclude USB/misc firmware not used by the MM8108 dongle.
CONFIG_PACKAGE_ftdi-usb-spi=n
CONFIG_PACKAGE_kmod-ftdi-usb-spi=n
CONFIG_PACKAGE_edgeport-firmware=n
CONFIG_PACKAGE_r8152-firmware=n
CONFIG_PACKAGE_kmod-usb-serial-edgeport=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-owl-loader=n

# Exclude extra filesystems and software that are too heavy for MT76x8.
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_tailscale=n

CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_kmod-crypto-michael-mic=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-pps=y
CONFIG_PACKAGE_kmod-ptp=y
