CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_DEVICE_bcm27xx_bcm2712_DEVICE_rpi-5=y

CONFIG_VERSION_MANUFACTURER="Raspberry Pi"
CONFIG_VERSION_PRODUCT="Raspberry Pi 5 + MM8108 USB"

# Interactive terminal recovery. OpenWrt's BusyBox defaults enable line
# editing, but not stty or automatic terminal resize tracking.
CONFIG_BUSYBOX_CONFIG_STTY=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_WINCH=y

# MM8108 package selection follows Morse Micro's official MM8108 OpenWrt
# profile. The bcm2712 target and USB transport follow the working Pi 5 port
# documented in this directory's README.
CONFIG_PACKAGE_kmod-morse=y
CONFIG_PACKAGE_netifd-morse=y
CONFIG_PACKAGE_morse-board-config=y
CONFIG_PACKAGE_morse-regdb=y
CONFIG_MORSE_USB=y
CONFIG_MORSE_SDIO=n
CONFIG_MORSE_SPI=n
CONFIG_MORSE_USER_ACCESS=y
CONFIG_MORSE_VENDOR_COMMAND=y

CONFIG_PACKAGE_morse-fw-6108=n
CONFIG_PACKAGE_morse-fw-6108-tlm=n
CONFIG_PACKAGE_morse-fw-8108=y
CONFIG_PACKAGE_morse-fw-8108-tlm=y
CONFIG_PACKAGE_morse-fw-8108-flm=m
CONFIG_PACKAGE_morse-board-config-hotplug-model=y

CONFIG_PACKAGE_bsp-bcm271x=y

# The working Raspberry Pi 5 reference reserves 64 MiB for its boot partition.
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=4092
CONFIG_TARGET_ROOTFS_EXT4FS=n
