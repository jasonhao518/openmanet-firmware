CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_heltec_ht-h7608-v1-lite=y

# The mt76x8 target advertises both squashfs and ramdisk support, which makes
# Kconfig enable the initramfs image by default. This recovery profile must
# explicitly request a flashable squashfs image and suppress ramdisk-only
# output.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=n

# Deliberately use a recognizable recovery identity. This profile contains
# base OpenWrt plus MT7603 recovery Wi-Fi; it is not an OpenMANET image.
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt-BootTest"
CONFIG_VERSION_NUMBER="24.10"
CONFIG_VERSION_CODE="ht-h7608-v1-lite"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_MANUFACTURER="Heltec"
CONFIG_VERSION_PRODUCT="HT-H7608-V1-WiFi-Recovery"

# Keep OpenWrt failsafe available and use its conventional recovery subnet.
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_DISABLE_FAILSAFE=n
CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y

# Make the intended boot baseline explicit. Ethernet support for MT7628 is
# built into the target kernel; these are the small userspace essentials.
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y

# Recovery access over the MT7628's integrated 2.4 GHz radio. Keep the
# wireless stack explicit so changes to OpenWrt's default package set cannot
# silently remove the AP from this image.
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# The recovery image needs no HaLow hardware or SDIO stack.
CONFIG_PACKAGE_kmod-mmc=n
CONFIG_PACKAGE_kmod-sdhci-mt7620=n
CONFIG_PACKAGE_kmod-morse=n
CONFIG_PACKAGE_netifd-morse=n
CONFIG_PACKAGE_morse-fw-6108=n
